+    Parser.Lex(); // consume the final register or update sign
+    if (Parser.getTok().is(AsmToken::LBrac)) {
+        Parser.Lex();
+        int64_t Count;
+        if (Parser.parseAbsoluteExpression(Count))
+            return true;
+        if (Count < 1 || Count > 16)
+            return Error(S, "pointer update must be in [1, 16]");
+        if (!Parser.getTok().is(AsmToken::RBrac))

+// The parent installer owns the USB permission. Reopening an FTDI port
+// can reset the P2 and discard a program just loaded into hub RAM.
+export async function connectInstalledP2(serialPort) {
+    if (port) throw new Error('Disconnect the current IDE session first.')
+    const transport = new WebSerial()
+    transport.port = serialPort
+    const info = serialPort.getInfo()
+    transport.info = {
+        vid: info.usbVendorId?.toString(16).padStart(4, '0'),
+        pid: info.usbProductId?.toString(16).padStart(4, '0'),
+    }
+    await transport.connect(true)
+    return startSession('usb', transport)
+}
+
+export async function openP2Example(profile, blinker) {
+    const base = blinker ? '/blink_p2' : '/hello_p2'; let fn = base + '.py', i = 1

+    let content = '# Press F5 to run this on your board.\nimport sys\nprint("Hello from", sys.platform)\n'
+    if (profile === 'edge') {
+        content += '\nimport p2\nprint("External RAM:", p2.PSRAM().capacity() // (1024 * 1024), "MiB")\n'
+    }
+    await _loadContent(fn, blinker || content, createTab(fn))
+}
